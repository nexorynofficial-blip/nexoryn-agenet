# --- LLM (extraction only — this is the ONLY thing this backend does) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=claude-haiku-4-5-20251001

# --- Runtime ---
PORT=8000

# --- CORS ---
# The widget calls this backend from the browser, on the dashboard's
# own origin — which will be a different origin once this is deployed.
# Comma-separated, no trailing slashes. Include your production
# dashboard domain and any local dev ports you use.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://nexoryn-delta.vercel.app

# NOTE: there is deliberately no dashboard URL, login, or admin
# credential here. This backend never talks to the dashboard at all —
# uploading images and filling the real form happens client-side in
# the widget, inside the admin's own already-authenticated browser
# tab. See widget/README.md.
